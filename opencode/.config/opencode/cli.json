{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "kiahgawa",
    "mode": "dark"
  },
  "keybinds": {
    "command.palette.show": "ctrl+l",
    "variant.cycle": "ctrl+o"
  },
  "diffs": {
    "wrap": "word",
    "view": "auto"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide",
    "verbosity": "medium",
    "image_preview": true,
    "tps": false,
    "permissions": "prompt"
  },
  "animations": true,
  "mini": {
    "work_spinner": "block-soft-slide"
  },
  "tabs": {
    "layout": "horizontal",
    "scope": "global",
    "mode": "off",
    "indicators": "status"
  },
  "prompt": {
    "image_preview": true,
    "paste": "full"
  },
  "terminal": {
    "title": true
  },
  "debug": {
    "devtools": false
  }
}
