{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "kiahgawa",
    "mode": "dark"
  },
  "keybinds": {
    "command.palette.show": "ctrl+l",
    "variant.cycle": "ctrl+o"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide"
  },
  "animations": true,
  "mini": {
    "work_spinner": "block-soft-slide"
  },
  "tabs": {
    "layout": "horizontal",
    "scope": "cwd",
    "mode": "off",
    "indicators": "status"
  },
  "prompt": {
    "image_preview": true
  }
}
