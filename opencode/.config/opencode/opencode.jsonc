{
  "$schema": "https://opencode.ai/config.json",
  "experimental": {
    "background_compaction": true
  },
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "mcp": {
    "servers": {
      "xcode": {
        "type": "local",
        "command": [
          "/Users/miciah/.local/bin/uv",
          "run",
          "--quiet",
          "--script",
          "/Users/miciah/.local/scripts/xcode-mcp-router.py"
        ]
      }
    }
  }
}
