{
  "$schema": "https://opencode.ai/config.json",
  "plugins": ["./plugins/opener"],
  "experimental": {
    "background_compaction": true,
    "schedules": true,
    "image_generate": true
  },
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "mcp": {
    "servers": {
      "xcode": {
        "type": "local",
        "command": [
          "/Users/miciah/.local/bin/uv",
          "run",
          "--quiet",
          "--script",
          "/Users/miciah/.local/scripts/xcode-mcp-router.py"
        ]
      },
      "open-computer-use": {
        "type": "local",
        "command": ["/opt/homebrew/bin/open-computer-use", "mcp"]
      }
    }
  }
}
