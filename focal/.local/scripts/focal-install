#!/usr/bin/env bash
set -euo pipefail

resolve_script() {
  local path="$1"
  local directory target

  while [[ -L "$path" ]]; do
    directory="$(cd "$(dirname "$path")" && pwd -P)"
    target="$(readlink "$path")"
    if [[ "$target" = /* ]]; then
      path="$target"
    else
      path="$directory/$target"
    fi
  done

  directory="$(cd "$(dirname "$path")" && pwd -P)"
  printf '%s/%s\n' "$directory" "$(basename "$path")"
}

script_path="$(resolve_script "${BASH_SOURCE[0]}")"
script_dir="$(dirname "$script_path")"
package_root="$(cd "$script_dir/../.." && pwd -P)"
repo_root="$(cd "$package_root/.." && pwd -P)"
source_dir="$package_root/.local/src/focal"
app_dir="$HOME/Applications/Focal.app"
launch_agent="$HOME/Library/LaunchAgents/com.miciah.focal.plist"
label="com.miciah.focal"
domain="gui/$(id -u)"
mkdir -p "$HOME/Applications"
scratch="$(mktemp -d "${TMPDIR:-/tmp}/focal-install.XXXXXX")"
staging_root="$(mktemp -d "$HOME/Applications/.focal-install.XXXXXX")"
staged_app="$staging_root/Focal.app"
trap 'rm -rf "$scratch" "$staging_root"' EXIT

"$package_root/.local/scripts/focal-test"

printf 'Building Focal.app...\n' >&2
swift build \
  --configuration release \
  --package-path "$source_dir" \
  --scratch-path "$scratch"
bin_dir="$(swift build \
  --configuration release \
  --package-path "$source_dir" \
  --scratch-path "$scratch" \
  --show-bin-path)"

mkdir -p "$staged_app/Contents/MacOS"
cp "$source_dir/Resources/Info.plist" "$staged_app/Contents/Info.plist"
install -m 0755 "$bin_dir/Focal" "$staged_app/Contents/MacOS/Focal"

identity="${FOCAL_CODESIGN_IDENTITY:-}"
if [[ -z "$identity" ]]; then
  identity="$(security find-identity -v -p codesigning 2>/dev/null \
    | awk -F'"' '/Apple Development: Miciah Henderson/{print $2; exit}')"
fi
if [[ -z "$identity" ]]; then
  identity="$(security find-identity -v -p codesigning 2>/dev/null \
    | awk -F'"' '/Apple Development:/{print $2; exit}')"
fi
if [[ -z "$identity" ]]; then
  identity="-"
  printf 'Warning: no Apple Development signing identity found; using ad-hoc signing.\n' >&2
  printf 'Accessibility permissions may need to be granted again after rebuilds.\n' >&2
fi

printf 'Signing with %s...\n' "$identity" >&2
codesign \
  --force \
  --sign "$identity" \
  --identifier com.miciah.focal \
  --timestamp=none \
  "$staged_app"
codesign --verify --deep --strict --verbose=2 "$staged_app"

printf 'Stowing focal configuration...\n' >&2
stow --dir "$repo_root" --target "$HOME" focal
mkdir -p "$HOME/Library/Logs"

if launchctl print "$domain/$label" >/dev/null 2>&1; then
  launchctl bootout "$domain/$label"
fi

for _ in {1..20}; do
  if ! pgrep -f "$app_dir/Contents/MacOS/Focal" >/dev/null 2>&1; then
    break
  fi
  sleep 0.1
done

rm -rf "$app_dir"
mv "$staged_app" "$app_dir"

lsregister="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"
if [[ -x "$lsregister" ]]; then
  "$lsregister" -f "$app_dir" >/dev/null 2>&1 || true
fi

printf 'Starting %s...\n' "$label" >&2
launchctl bootstrap "$domain" "$launch_agent"
launchctl kickstart -k "$domain/$label"
sleep 2

if ! launchctl print "$domain/$label" >/dev/null 2>&1; then
  printf 'focal-install: launch agent did not start\n' >&2
  exit 1
fi

printf '\nInstalled %s\n' "$app_dir" >&2
printf '%s\n' \
  'If macOS asks, grant Focal Accessibility. Focal starts arranging windows as soon' \
  'as it has it. If the Focal menu-bar icon stays, choose “Restart Agent After Granting”.' \
  'Shortcuts: ⌃⌘P pair mode, ⌃⌘S swap sides, ⌃⌘D next display.' >&2
